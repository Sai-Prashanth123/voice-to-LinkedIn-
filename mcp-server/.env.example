# Credentials for the MCP server. Copy to mcp-server/.env and fill in.
# Not committed — .gitignore covers .env at any depth.

SUPABASE_URL=https://<project-ref>.supabase.co

# The scoped role's key, created by task 1.4 (migration 0028_mcp_role.sql).
# NOT the service-role key: that bypasses row-level security entirely, and the
# point of this server is to hand the model a door rather than the building.
CONTENT_MCP_KEY=

# Optional. How long to wait on the database before giving up. Default 15000.
# CONTENT_MCP_TIMEOUT_MS=15000

# Optional, and only for refreshing the reference writers yourself.
#
# scripts/scrape-sentinels.mjs fetches the eight writers' recent posts through Apify, which Josh
# named at the kickoff call. Without it, the posts already in the system stay readable and simply
# stop being refreshed — and refreshing them would depend on Thought Pilot's own scraping console,
# which is the one thing clause 14.3 says must not be true of anything here.
#
# A token is one page in the Apify console, under Settings -> Integrations. It is charged per run and
# a full refresh is eight profiles.
# APIFY_TOKEN=apify_api_...

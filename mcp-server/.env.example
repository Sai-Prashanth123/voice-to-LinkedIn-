# Credentials for the MCP server. Copy to mcp-server/.env and fill in.
# Not committed — .gitignore covers .env at any depth.

SUPABASE_URL=https://<project-ref>.supabase.co

# The scoped role's key, created by task 1.4 (migration 0028_mcp_role.sql).
# NOT the service-role key: that bypasses row-level security entirely, and the
# point of this server is to hand the model a door rather than the building.
CONTENT_MCP_KEY=

# Optional. How long to wait on the database before giving up. Default 15000.
# CONTENT_MCP_TIMEOUT_MS=15000

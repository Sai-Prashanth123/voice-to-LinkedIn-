# Secrets. Credentials live in Supabase Vault; these are only local convenience.
.env
.env.local
.env*.local

# Dependencies and build output
node_modules/
.next/
out/
dist/

# Local state
eval/results/
*.log
.DS_Store
Thumbs.db

# The Claude Code agent's local cursor file lives in the user's home directory,
# not here, but ignore any stray copy.
.content-system-state.json

# Generated by cc-agent/install.mjs — a shim that loads .env before the agent.
cc-agent/run-scheduled.mjs

# Evaluation harness credentials. See eval/.env.example.
eval/.env

# Deploy artefact, rebuilt by the host. Never committed.
app/desk-deploy.zip

# Josh's call recordings (docs/from-josh/README.md, "Two cautions before sending").
# Redacted, but he flagged that the 31 August call keeps clinical vertical language and anyone in
# that market could infer the client. Git history is permanent and this repository is the handover
# vehicle, so they stay out of it until he decides whether that is acceptable. They are on disk and
# in his Drive either way; nothing is lost by waiting for his answer.
docs/from-josh/transcripts/

# HTTP MCP tokens (mcp-server/mint-http-tokens.mjs). Secrets, never committed.
mcp-server/.http-tokens

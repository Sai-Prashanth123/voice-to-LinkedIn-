# Secrets. Credentials live in Supabase Vault; these are only local convenience.
.env
.env.local
.env*.local

# Dependencies and build output
node_modules/
.next/
out/
dist/

# Local state
eval/results/
*.log
.DS_Store
Thumbs.db

# The Claude Code agent's local cursor file lives in the user's home directory,
# not here, but ignore any stray copy.
.content-system-state.json

# Generated by cc-agent/install.mjs — a shim that loads .env before the agent.
cc-agent/run-scheduled.mjs

# Evaluation harness credentials. See eval/.env.example.
eval/.env

# Deploy artefact, rebuilt by the host. Never committed.
app/desk-deploy.zip

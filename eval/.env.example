# Credentials for the evaluation harnesses (acceptance.mjs, gate-acceptance.mjs, regression.mjs).
#
# NOT COMMITTED — .gitignore covers eval/.env. The service role key bypasses RLS entirely, so it
# lives here rather than in a shell export, where it would end up in shell history.
#
# Both values are on the Supabase dashboard under Project Settings -> API.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
